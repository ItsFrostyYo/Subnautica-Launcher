<Application x:Class="SubnauticaLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="UI/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="UI/Styles/CommonStyles.xaml" />
        </ResourceDictionary.MergedDictionaries>

        <FontFamily x:Key="AppFontFamily">pack://application:,,,/Assets/Subnautica/#Aller</FontFamily>

        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
        </Style>

        <Style TargetType="Control">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
