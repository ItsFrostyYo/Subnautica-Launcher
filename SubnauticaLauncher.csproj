<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\Icons\SNL.ico</ApplicationIcon>
    <StartupObject>SubnauticaLauncher.Program</StartupObject>
    <RootNamespace>SubnauticaLauncher</RootNamespace>
    <!-- Keep Properties\AssemblyInfo.cs as the single source of truth for the launcher version. -->
    <LauncherAssemblyInfoFile>$(MSBuildProjectDirectory)\Properties\AssemblyInfo.cs</LauncherAssemblyInfoFile>
    <LauncherAssemblyInfoText>$([System.IO.File]::ReadAllText('$(LauncherAssemblyInfoFile)'))</LauncherAssemblyInfoText>
    <Version>$([System.Text.RegularExpressions.Regex]::Match('$(LauncherAssemblyInfoText)', 'AssemblyVersion\s*\(\s*&quot;([^&quot;]+)&quot;\s*\)').Groups[1].Value)</Version>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Updater\**\*.cs" />
    <Compile Remove="Artifacts\**\*.cs" />
    <Compile Remove="External Research\**\*.cs" />
    <EmbeddedResource Remove="Updater\**\*" />
    <None Remove="Updater\**\*" />
    <Resource Include="Assets\**\*" />
    <Content Include="Dependencies\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Reference Include="LiveSplit.Core">
      <HintPath>Dependencies\LiveSplit.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="LiveSplit.Timer">
      <HintPath>Dependencies\LiveSplit.Timer.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UpdateManager">
      <HintPath>Dependencies\UpdateManager.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Text.Json">
      <HintPath>Dependencies\System.Text.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Text.Encodings.Web">
      <HintPath>Dependencies\System.Text.Encodings.Web.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.IO.Pipelines">
      <HintPath>Dependencies\System.IO.Pipelines.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Content Include="Updates\SNLUpdates.xml">
      <Link>Data\SNLUpdates.xml</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Updates\SNLUUpdates.xml">
      <Link>Data\SNLUUpdates.xml</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="ValidateLauncherVersion" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Version)' == ''"
           Text="Properties\AssemblyInfo.cs must contain an AssemblyVersion attribute so the project version can be determined." />
  </Target>
</Project>
