<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SNLUpdater</AssemblyName>
    <Version>1.0.2</Version>
    <AssemblyVersion>1.0.2.0</AssemblyVersion>
    <FileVersion>1.0.2.0</FileVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Updates\LauncherUpdateModels.cs" Link="Updates\LauncherUpdateModels.cs" />
    <Compile Include="..\Updates\UpdateProgressWindow.cs" Link="Updates\UpdateProgressWindow.cs" />
    <Resource Include="..\Assets\Icons\SNLIcon.png" Link="Assets\Icons\SNLIcon.png" />
    <Resource Include="..\Assets\Subnautica\aller.regular.ttf" Link="Assets\Subnautica\aller.regular.ttf" />
  </ItemGroup>
</Project>
