<Window x:Class="SubnauticaLauncher.UI.LauncherUpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Launcher Update Available"
        Width="560"
        Height="430"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner">
    <Border CornerRadius="14"
            BorderBrush="#66FFFFFF"
            BorderThickness="1"
            Background="#F20A1827"
            Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Image Source="pack://application:,,,/Assets/Icons/SNLIcon.png"
                       Width="28" Height="28" Margin="0,0,12,0"/>
                <TextBlock x:Name="HeadingText"
                           FontSize="20"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <TextBlock x:Name="ReleaseTitleText"
                       Grid.Row="1"
                       Margin="0,14,0,0"
                       FontSize="15"
                       Foreground="#FFD8F0FF"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"/>

            <TextBlock x:Name="ReleaseDateText"
                       Grid.Row="2"
                       Margin="0,4,0,12"
                       FontSize="12"
                       Foreground="#FFC7DCEB"
                       TextWrapping="Wrap"/>

            <Border Grid.Row="3" Background="#50000000" CornerRadius="10" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="What's New" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                        <StackPanel x:Name="ChangelogPanel"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                <Button Content="Later" Width="130" Margin="0,0,12,0" Style="{StaticResource RoundedButton}" Click="Later_Click"/>
                <Button Content="Update Now" Width="150" Background="{StaticResource LaunchAccentBrush}" Style="{StaticResource RoundedButton}" Click="Update_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
