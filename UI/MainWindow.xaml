<Window x:Class="SubnauticaLauncher.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Subnautica Launcher"
        Width="1000"
        Height="550"
        MinWidth="1000"
        MinHeight="550"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Background>
        <SolidColorBrush Color="#FF0A0E18" />
    </Window.Background>

    <Window.Resources>
        <SolidColorBrush x:Key="TitleBrush" Color="#90000000" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#90000000" />
        <SolidColorBrush x:Key="SidebarTextBrush" Color="#F4F8FF" />
        <SolidColorBrush x:Key="SidebarMutedBrush" Color="#AEBBD6" />
        <SolidColorBrush x:Key="SidebarHoverBrush" Color="#663AA8FF" />
        <SolidColorBrush x:Key="SidebarActiveBrush" Color="#661A6F3C" />
        <SolidColorBrush x:Key="PanelBrush" Color="#90000000" />
        <SolidColorBrush x:Key="ButtonBrush" Color="#C81A2337" />
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#7C95BD" />
        <SolidColorBrush x:Key="LaunchBrush" Color="#FF4FD38B" />
        <SolidColorBrush x:Key="DangerBrush" Color="#8B2C2C" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style TargetType="{x:Type ToolTip}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#E8101725" />
            <Setter Property="BorderBrush" Value="#7C95BD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToolTip}">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarNavButton" TargetType="Button">
            <Setter Property="Width" Value="214" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="12,11" />
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="{StaticResource SidebarHoverBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="NavBorder" Property="Background" Value="{StaticResource SidebarActiveBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Matches the original launcher's normal dark secondary action button. -->
        <Style x:Key="RoundedButton" TargetType="Button" BasedOn="{StaticResource RoundedButtonBase}">
            <Setter Property="Background" Value="{StaticResource ButtonBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource ButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="VersionIconButton" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="VersionTileIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="VersionTileTextButton" TargetType="Button" BasedOn="{StaticResource VersionTileIconButton}"/>

        <Style x:Key="PluginTabButton" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="Background" Value="#8A101725" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="Active">
                    <Setter Property="Background" Value="#B52A6181" />
                    <Setter Property="BorderBrush" Value="#D6E7FF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="25"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <!-- Keep the artwork soft behind controls while panels remain readable. -->
        <Image x:Name="MainBackgroundImage"
               Source="pack://application:,,,/Assets/Backgrounds/Aurora Borealis.png"
               Stretch="UniformToFill"
               IsHitTestVisible="False">
            <Image.Effect>
                <BlurEffect Radius="2.0" />
            </Image.Effect>
        </Image>

        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="25" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource TitleBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image Source="pack://application:,,,/Assets/Icons/SNLIcon.png"
                   Width="16"
                   Height="16"
                   Margin="12,0,8,0"
                   VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Subnautica Launcher" FontSize="13" FontWeight="SemiBold" Margin="0,0,6,0" />
                <TextBlock x:Name="LauncherVersionText" FontSize="13" Opacity="0.7" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="&#x2014;" Width="44" Height="25" Background="Transparent" BorderBrush="#55000000" BorderThickness="1"
                        Click="Minimize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button Content="&#x25A1;" Width="44" Height="25" Background="Transparent" BorderBrush="#55000000" BorderThickness="1"
                        Click="Maximize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button Content="&#x2715;" Width="44" Height="25" Background="{StaticResource DangerBrush}" BorderBrush="#55000000" BorderThickness="1"
                        Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            </StackPanel>
        </Grid>

        <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="UpOnly">
            <Grid Width="1000" Height="525">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="266" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource SidebarBrush}">
                    <Grid Margin="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="6,10,4,0">
                            <TextBlock Text="NAVIGATION" Margin="8,0,0,12" FontSize="10" Foreground="{StaticResource SidebarMutedBrush}" />
                            <Button x:Name="PlayNavButton" Content="Play" Tag="Active" Style="{StaticResource SidebarNavButton}" Click="PlayNav_Click" />
                            <Button x:Name="SettingsNavButton" Content="Settings" Style="{StaticResource SidebarNavButton}" Click="SettingsNav_Click" />
                            <Button x:Name="PluginsNavButton" Content="Plugins" Style="{StaticResource SidebarNavButton}" Click="PluginsNav_Click" />
                            <Button x:Name="InfoNavButton" Content="Launcher Info" Style="{StaticResource SidebarNavButton}" Click="InfoNav_Click" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="6,18,4,6">
                            <Button x:Name="SwitchButton" Content="Switch" Width="108" Height="38" HorizontalAlignment="Center" Margin="0,0,0,16"
                                    Style="{StaticResource RoundedButton}" IsEnabled="False" Click="SwitchButton_Click" />
                            <TextBlock Text="SELECTED VERSION" FontSize="11" Foreground="{StaticResource SidebarMutedBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="SelectedVersionText" Margin="0,10,0,18" FontSize="12" Foreground="{StaticResource SidebarTextBrush}"
                                       Text="Select a version to enable launch." TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                            <TextBlock Text="VERSION STATUS" FontSize="11" Foreground="{StaticResource SidebarMutedBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="VersionStatusText" Margin="0,10,0,14" FontSize="12" Foreground="{StaticResource SidebarTextBrush}"
                                       Text="No game activity." TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                            <Button x:Name="LaunchButton" Content="Launch" Width="192" Height="46" HorizontalAlignment="Center" Background="{StaticResource LaunchBrush}"
                                    Foreground="White" FontSize="18" FontWeight="Bold" Style="{StaticResource RoundedButton}" IsEnabled="False" Click="LaunchButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid x:Name="SettingsView" Visibility="Collapsed" Margin="42,42,42,34">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Margin="0,0,12,0" Padding="16" Background="#A8101725" CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="Customize" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                                <TextBlock Text="Background" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ComboBox x:Name="ThemeDropdown" Height="35" Style="{StaticResource MainDarkComboBox}" SelectionChanged="ThemeDropdown_SelectionChanged">
                                    <ComboBoxItem Content="Lifepod"/><ComboBoxItem Content="Safe Shallows"/><ComboBoxItem Content="Kelp Forest"/><ComboBoxItem Content="Grassy Plateau"/><ComboBoxItem Content="Lost River"/><ComboBoxItem Content="Cove Tree"/><ComboBoxItem Content="Floating Island"/><ComboBoxItem Content="Jellyshroom Caves"/><ComboBoxItem Content="Grand Reef"/><ComboBoxItem Content="Reaper Leviathan"/><ComboBoxItem Content="Ghost Leviathan"/><ComboBoxItem Content="Sea Dragon Leviathan"/><ComboBoxItem Content="Twisty Bridges"/><ComboBoxItem Content="Aurora Borealis"/><ComboBoxItem Content="Snowfox"/><ComboBoxItem Content="Icy Land"/><ComboBoxItem Content="Arcitect Facility"/><ComboBoxItem Content="Red Crystals"/><ComboBoxItem Content="Snow Stalker"/><ComboBoxItem Content="Squid Shark"/><ComboBoxItem Content="Shadow Leviathan"/><ComboBoxItem Content="Custom"/>
                                </ComboBox>
                                <Button Content="Choose Custom Background" Height="38" Padding="16,5" Margin="0,14,0,4" Style="{StaticResource RoundedButton}" Click="ChooseCustomBackground_Click"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Margin="12,0,0,0" Padding="16" Background="#A8101725" CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="Options" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                                <TextBlock Text="Force to Launch With Steam" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <Button x:Name="ForceSteamButton" Content="Disabled" Width="154" Height="38" HorizontalAlignment="Left" Margin="0,6,0,12" Background="{StaticResource DangerBrush}" Style="{StaticResource RoundedButton}" Click="ForceSteamButton_Click"/>
                                <TextBlock Text="Save Subnautica Settings" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <Button Content="Manage" Width="154" Height="38" HorizontalAlignment="Left" Margin="0,6,0,12" Style="{StaticResource RoundedButton}" Click="ManageSubnauticaSettings_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border x:Name="PluginsView" Visibility="Collapsed" Margin="42,34,34,22" Padding="18" Background="#A8101725" CornerRadius="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42" />
                                <RowDefinition Height="42" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Plugins" FontSize="26" FontWeight="Bold" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Width="292" Height="36" Background="#8A080D17" BorderBrush="#7C95BD" BorderThickness="1" CornerRadius="15" VerticalAlignment="Center">
                                    <Grid>
                                        <TextBox x:Name="PluginSearchBox"
                                                 Margin="12,0"
                                                 Padding="0"
                                                 VerticalContentAlignment="Center"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="White"
                                                 CaretBrush="White"
                                                 FontSize="14"
                                                 TextChanged="PluginSearchBox_TextChanged" />
                                        <TextBlock x:Name="PluginSearchPlaceholder"
                                                   Text="Search..."
                                                   Margin="13,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="#99FFFFFF"
                                                   FontSize="14"
                                                   IsHitTestVisible="False" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button x:Name="InstalledPluginsTabButton"
                                        Content="Installed (0)"
                                        Width="150"
                                        Margin="0,0,8,0"
                                        Tag="Active"
                                        Style="{StaticResource PluginTabButton}"
                                        Click="InstalledPluginsTab_Click" />
                                <Button x:Name="BrowsePluginsTabButton"
                                        Content="Browse Plugins"
                                        Width="160"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource PluginTabButton}"
                                        Click="BrowsePluginsTab_Click" />
                            </StackPanel>

                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                              HorizontalScrollBarVisibility="Disabled"
                                              PanningMode="VerticalOnly"
                                              CanContentScroll="False">
                                    <ItemsControl x:Name="PluginCards">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Height="154" Margin="0,0,0,14" Padding="16" Background="#8A101725" BorderBrush="#457C95BD" BorderThickness="1" CornerRadius="12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Width="86" Height="86" Margin="0,0,16,0" CornerRadius="12" Background="#58151D2C"
                                                                Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <Image Source="{Binding IconPath}" Width="76" Height="76" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                            <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Author}" Margin="0,3,0,7" FontSize="12" Foreground="{StaticResource SidebarMutedBrush}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Description}" FontSize="13" Foreground="#E1E8F4" TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Error}" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" FontSize="11" Foreground="#FFFF8B8B" TextWrapping="Wrap" MaxHeight="30" Margin="0,4,0,0" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right">
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                <TextBlock Text="{Binding VersionLabel}" FontSize="12" Foreground="{StaticResource SidebarMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                                <Button Content="Update" Width="72" Height="30" Padding="7,3" Margin="0,0,8,0" Tag="{Binding}" Visibility="{Binding HasUpdate, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource RoundedButton}" Click="PluginUpdate_Click" />
                                                                <Button Content="&#x2699;" Width="34" Height="30" Padding="0" Tag="{Binding}" Visibility="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="Plugin Settings" Style="{StaticResource RoundedButton}" Click="PluginSettings_Click" />
                                                            </StackPanel>
                                                            <Button Content="{Binding ActionText}" ToolTip="{Binding ActionToolTip}" Width="110" Height="30" Padding="8,3" Margin="0,8,0,0" HorizontalAlignment="Right" Tag="{Binding}" Background="{Binding ActionBrush}" Style="{StaticResource RoundedButton}" Click="PluginAction_Click" />
                                                            <Button Content="Remove" Width="110" Height="30" Padding="8,3" Margin="0,7,0,0" HorizontalAlignment="Right" Tag="{Binding}" Visibility="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#FF8B2C2C" Style="{StaticResource RoundedButton}" Click="PluginRemove_Click" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock x:Name="PluginEmptyText"
                                           Text="No plugins are installed."
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource SidebarMutedBrush}"
                                           FontSize="15"
                                           TextAlignment="Center"
                                           IsHitTestVisible="False" />
                            </Grid>
                        </Grid>
                    </Border>
                    <Grid x:Name="InfoView" Visibility="Collapsed" Margin="42,34,34,22">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
                        <TextBlock Text="Launcher Info" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" PanningMode="VerticalOnly" CanContentScroll="False"><Border Background="#A8101725" CornerRadius="14" Padding="14"><StackPanel x:Name="UpdatesPanel"/></Border></ScrollViewer>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6,0,0">
                            <Button Background="Transparent" BorderThickness="0" Foreground="White" Cursor="Hand" Margin="16,0" Click="OpenGitHub_Click"><StackPanel><Image Source="pack://application:,,,/Assets/Icons/GithubIcon.png" Width="32" Height="32" Margin="0,0,0,4"/><TextBlock Text="Launcher GitHub" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel></Button>
                            <Button Background="Transparent" BorderThickness="0" Foreground="White" Cursor="Hand" Margin="16,0" Click="OpenYouTube_Click"><StackPanel><Image Source="pack://application:,,,/Assets/Icons/YoutubeIcon.png" Width="32" Height="32" Margin="0,0,0,4"/><TextBlock Text="My YouTube" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel></Button>
                            <Button Background="Transparent" BorderThickness="0" Foreground="White" Cursor="Hand" Margin="16,0" Click="OpenDiscord_Click"><StackPanel><Image Source="pack://application:,,,/Assets/Icons/DiscordIcon.png" Width="32" Height="32" Margin="0,0,0,4"/><TextBlock Text="Speedrun Discord" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel></Button>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0">
                        <Button Content="Add Version"
                                x:Name="AddVersionButton"
                                Width="164"
                                Height="38"
                                Padding="12,5"
                                Style="{StaticResource RoundedButton}"
                                Click="AddVersion_Click" />
                        <Button Content="Change Ordering"
                                x:Name="ChangeOrderingButton"
                                Width="164"
                                Height="38"
                                Margin="12,0,0,0"
                                Padding="12,5"
                                Style="{StaticResource RoundedButton}"
                                Click="ChangeOrdering_Click" />
                    </StackPanel>
                    <Border x:Name="PlayVersionsPanel" Margin="22,76,18,22" Padding="16,15" Background="#A8101725" CornerRadius="14">
                        <ScrollViewer x:Name="PlayContentScrollViewer"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled"
                                      PanningMode="VerticalOnly"
                                      CanContentScroll="False"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center">
                            <ItemsControl x:Name="VersionTiles" Width="656" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="140" Margin="0,0,24,22" HorizontalAlignment="Center">
                                    <Button x:Name="VersionTileButton" Width="96" Height="96" Padding="0" HorizontalAlignment="Center" Style="{StaticResource VersionTileIconButton}"
                                            Tag="{Binding}" Click="VersionTile_Click" ToolTip="{Binding GameFolder}">
                                        <Image Source="{Binding IconPath}" Width="92" Height="92" Stretch="Uniform" />
                                    </Button>
                                    <Button x:Name="VersionNameButton" Width="140" Margin="0,7,0,0" Padding="0" Tag="{Binding}" Click="VersionTile_Click" Style="{StaticResource VersionTileTextButton}">
                                        <Border Padding="2" CornerRadius="5" BorderThickness="2">
                                            <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, ElementName=VersionTileButton}" Value="True"><Setter Property="BorderBrush" Value="#FF3AA8FF"/></DataTrigger><DataTrigger Binding="{Binding IsMouseOver, ElementName=VersionNameButton}" Value="True"><Setter Property="BorderBrush" Value="#FF3AA8FF"/></DataTrigger><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="White"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Active"><Setter Property="BorderBrush" Value="#FF4FD38B"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Launched"><Setter Property="BorderBrush" Value="#FFFF4242"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                            <TextBlock Text="{Binding DisplayName}" MaxHeight="40" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Active"><Setter Property="Foreground" Value="#FF4FD38B"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Launched"><Setter Property="Foreground" Value="#FFFF4242"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Button>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                        <Button Content="&#x1F4C1;" ToolTip="Open Folder" Tag="{Binding}" Style="{StaticResource VersionIconButton}" Click="OpenVersionFolder_Click" />
                                        <Button Content="&#x2699;" ToolTip="Version Settings" Tag="{Binding}" Style="{StaticResource VersionIconButton}" Click="EditVersion_Click" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0"
                                                Visibility="{Binding IsOrdering, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Button Content="&#x2190;" ToolTip="Move Left" Tag="{Binding}" CommandParameter="-1" Style="{StaticResource VersionIconButton}" Click="MoveVersion_Click" />
                                        <Button Content="&#x2192;" ToolTip="Move Right" Tag="{Binding}" CommandParameter="1" Margin="6,0,0,0" Style="{StaticResource VersionIconButton}" Click="MoveVersion_Click" />
                                    </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Viewbox>
        </Grid>
    </Grid>
</Window>
