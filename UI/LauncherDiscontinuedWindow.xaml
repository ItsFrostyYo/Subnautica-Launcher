<Window x:Class="SubnauticaLauncher.UI.LauncherDiscontinuedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Subnautica Launcher Discontinued"
        Width="720"
        Height="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{DynamicResource AppFontFamily}">

    <Window.Resources>
        <ImageBrush x:Key="BackgroundBrush" Stretch="UniformToFill"/>
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="25"
                            ResizeBorderThickness="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border CornerRadius="14" ClipToBounds="True">
        <Grid>
            <Rectangle Fill="{StaticResource BackgroundBrush}">
                <Rectangle.Effect>
                    <BlurEffect Radius="8"/>
                </Rectangle.Effect>
            </Rectangle>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Background="#70000000"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image Source="pack://application:,,,/Assets/Icons/SNLIcon.png"
                           Width="16"
                           Height="16"
                           Margin="12,0,8,0"
                           VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="Subnautica Launcher"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,3,0,0"/>
                    <Button Grid.Column="2"
                            Content="&#x2715;"
                            Width="44"
                            Height="25"
                            Background="#8B2C2C"
                            BorderBrush="#55000000"
                            BorderThickness="1"
                            Click="Close_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>

                <Border Grid.Row="1"
                        Margin="18"
                        Padding="24"
                        Background="#B0000000"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="1"
                        CornerRadius="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="This Launcher is discontinued and will no longer receive updates"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="1"
                                   Margin="0,18,0,0"
                                   Text="The new Subnautica Launcher is available, or you can stay on this discontinued Launcher."
                                   FontSize="15"
                                   Foreground="#E6F4FF"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="2"
                                   Margin="0,14,0,0"
                                   Text="The new launcher no longer has Subnautica 2 support and will receive Below Zero support in the future. It also has a different Tools system using Plugins instead."
                                   FontSize="14"
                                   Foreground="#CFE8F5"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>

                        <StackPanel Grid.Row="4"
                                    Margin="0,24,0,0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <Button Content="Close"
                                    Width="120"
                                    Height="40"
                                    Margin="0,0,12,0"
                                    Background="{StaticResource DialogNeutralButtonBrush}"
                                    Style="{StaticResource RoundedButton}"
                                    Click="Close_Click"/>
                            <Button Content="Install Separately"
                                    Width="180"
                                    Height="40"
                                    Margin="0,0,12,0"
                                    Background="#1F6F9F"
                                    Style="{StaticResource RoundedButton}"
                                    Click="InstallSeparately_Click"/>
                            <Button Content="Update to new Launcher"
                                    Width="210"
                                    Height="40"
                                    Background="#2E8B57"
                                    Style="{StaticResource RoundedButton}"
                                    Click="UpdateLauncher_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
